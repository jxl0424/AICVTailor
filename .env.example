# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

# Which provider handles LLM calls: nim | claude_cli | ollama
LLM_PROVIDER=nim

# --- NVIDIA NIM (default, free tier from build.nvidia.com) ------------------
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model preference, highest priority first, comma separated. These are PREFIX
# hints resolved against the live /v1/models catalogue at startup -- if none
# match, the next entry is tried and the resolution is logged. Leave blank to
# use the defaults in config/models.yaml.
EXTRACTOR_MODEL=
REWRITER_MODEL=

# Client-side rate limit. The free tier ceiling is around 40 rpm; stay under it.
LLM_RPM=30

# --- Claude CLI adapter (optional, off by default) --------------------------
# Shells out to the `claude` binary on this machine. No session tokens, no
# scraping, no Anthropic API auth from application code.
ENABLE_CLAUDE_CLI=false
CLAUDE_CLI_PATH=claude

# --- Ollama (fully offline fallback) ----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# --- LaTeX ------------------------------------------------------------------
# Auto-detected in order: tectonic, latexmk, pdflatex. Set to force one, or to
# "none" to skip PDF generation entirely and only ever produce .tex.
LATEX_ENGINE=auto

# --- Semantic matching ------------------------------------------------------
# Static embeddings (~30MB, no torch). Falls back to lexical matching if the
# model is unavailable, at some cost to implied_by detection.
EMBEDDINGS_ENABLED=true
EMBEDDINGS_MODEL=minishlab/potion-base-8M

# --- Server -----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
OPEN_BROWSER=true
LOG_LEVEL=INFO
